# Dependencias (NO subir - se reinstalan con npm install)
node_modules/
backend/node_modules/
frontend/node_modules/

# Variables de entorno (¡NUNCA subir contraseñas!)
.env
backend/.env

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de VS Code
.vscode/

# Archivos temporales
*.tmp
*.bak
*.swp

# Datos locales de MySQL (cada integrante tiene los suyos)
mysql-data/

# Respaldos locales de la BD (contienen datos reales)
respaldo*.sql

# Copia generada del frontend para Vercel (scripts/preparar-vercel.js)
/public/
.vercel/
